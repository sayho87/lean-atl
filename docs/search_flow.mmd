---
title: "lean-atl · Confluence 검색 흐름"
config:
  flowchart:
    curve: basis
    nodeSpacing: 50
    rankSpacing: 60
  theme: base
  themeVariables:
    fontFamily: "'Pretendard','Apple SD Gothic Neo','Helvetica Neue',Arial,sans-serif"
    fontSize: 15px
    primaryColor: "#eef2ff"
    primaryBorderColor: "#6366f1"
    primaryTextColor: "#1f2937"
    lineColor: "#94a3b8"
    nodeBorderWidth: 1.5
---

flowchart TD
    U["사용자 질문<br/><i>예) 'PGM 쿠폰 노출 조건'</i>"] --> M["모델(클로드)<br/>confluence_search 호출"]

    M -- "cql = 질문 그대로" --> Q{"CQL처럼 보이나?<br/>(= · ~ · AND · currentUser etc.)"}

    Q -- "예" --> QUERY["CQL 유지<br/>그대로 전달"]
    Q -- "아니오 (일반 문장)" --> KW["<b>질문 가공</b><br/>·'내 …' → currentUser<br/>·'주간보고' → 키워드로<br/>·조사·군더더기 제거"]
    KW --> KWQ{"'내 문서/이슈'인가?"}
    KWQ -- "예" --> Q1["<b>내 문서 우선</b><br/>siteSearch ~ … AND<br/>contributor=currentUser()"]
    KWQ -- "아니오" --> Q2["<b>사이트 검색</b><br/>siteSearch ~ '…'"]

    QUERY --> SCOPE
    Q1 --> SCOPE
    Q2 --> SCOPE

    SCOPE{"범위 좁히기 입력?<br/>(space_key · under_page)"}
    SCOPE -- "space_key 있음" --> SK["<b>공간 해석</b><br/>키 단건 → 이름 검색 → CQL<br/>→ 실제 키 확보"]
    SCOPE -- "under_page 있음" --> SP["<b>문서 해석</b><br/>숫자면 ID · 제목이면 검색<br/>→ 문서 ID 확보<br/>ancestor = &lt;id&gt; (하위 포함)"]
    SCOPE -- "없음" --> FILT

    SK --> FILT
    SP --> FILT
    FILT["<b>공간 필터 적용</b><br/>space = (CONFLUENCE_SPACES_FILTER에<br/>지정한 공간들)"]

    FILT --> RAW{"<b>1차 시도</b><br/>/rest/api/search<br/>웹과 같은 검색 색인 (siteSearch)"}

    RAW -- "결과 있음" --> RES["<b>결과 정리</b><br/>id · 제목 · 공간(key) · snippet"]
    RAW -- "DC가 excerpt 파라미터를<br/>400으로 거부하면" --> RETRY["같은 질의<br/>파라미터 없이 재시도"]
    RETRY -- "결과 있음" --> RES
    RETRY -- "여전히 비거나 에러면" --> FALLBACK["<b>2차 시도</b><br/>/rest/api/content/search<br/>제목·본문 CQL"]
    RAW -- "결과 없음/에러" --> FALLBACK

    FALLBACK -- "결과 있음" --> RES
    FALLBACK -- "0건" --> ZERO["<b>진단 반환</b><br/>{error, cql, endpoint,<br/>filter, hint}"]
    RES -- "필터 밖/중복 제거" --> OUT["<b>최종 응답</b><br/>결과 목록"]
    ZERO --> HINT["모델 안내<br/>· 목록 보여주고 고르게<br/>· 아니면 재질의"]

    OUT --> D["모델이 결과 요약<br/>· 정확치 않으면 재질의"]
    HINT --> D
